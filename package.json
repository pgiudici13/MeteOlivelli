{
  "name": "meteolivelli",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/create-static-routes.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "frontend:test": "node --test tests/frontend.test.mjs tests/forecast.test.mjs tests/quiz.test.mjs",
    "backend:check": "deno task --config supabase/functions/deno.json check",
    "backend:lint": "deno task --config supabase/functions/deno.json lint",
    "backend:test": "deno task --config supabase/functions/deno.json test",
    "uploader:test": "python3 -m unittest discover -s uploader/tests -v",
    "check": "npm run lint && npm run build && npm run frontend:test && npm run backend:check && npm run backend:lint && npm run backend:test && npm run uploader:test"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "pdfmake": "^0.3.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "deno": "2.9.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
