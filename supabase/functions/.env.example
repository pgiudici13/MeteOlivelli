# Solo esempio vuoto: non sovrascrivere configurazioni locali esistenti.
# Forniti dal runtime Supabase in produzione; solo sul server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Identificatore tecnico associato al token della sola stazione.
STATION_SOURCE_ID=
# Token opaco casuale di almeno 32 caratteri, custodito sul PC e sul server.
# Mai nel client Vite, in Git o nei log.
STATION_INGEST_TOKEN=
