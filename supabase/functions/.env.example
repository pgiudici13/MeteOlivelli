# Esempio server per il futuro endpoint: nessun valore reale o segreto generato.
# In produzione SUPABASE_URL è fornito dal runtime Supabase.
# Qui è lasciato vuoto per un eventuale ambiente di test configurato esplicitamente.
SUPABASE_URL=

# Convenzione del progetto per la futura autenticazione dell'uploader.
# Conservarlo sul PC e sul server; mai nel client Vite o nei log.
STATION_INGEST_TOKEN=

# La credenziale DB server non è ancora scelta: nessuna chiave privilegiata
# viene richiesta o configurata in questo setup.
