{
  "compilerOptions": {
    "strict": true
  },
  "nodeModulesDir": "none",
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "lineWidth": 100
  },
  "tasks": {
    "check": "deno check --no-remote --no-npm '**/*.ts'",
    "lint": "deno lint . && deno fmt --check .",
    "test": "deno test --no-prompt --no-remote --no-npm --deny-env --deny-net --deny-read --deny-write ."
  }
}
