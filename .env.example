# Esempio pubblico per il futuro collegamento frontend -> Supabase.
# Il template attuale funziona anche senza queste variabili.
# I nomi qui definiti sono convenzioni del progetto, non una lettura di .env.local.
# Non sovrascrivere un file .env.local già presente.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Tutto ciò che ha prefisso VITE_ può finire nel browser.
# Non aggiungere token uploader, secret key o service_role a questo file.
